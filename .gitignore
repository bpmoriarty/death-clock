# ── Personal data ─────────────────────────────────────────────────────────────
# settings.json holds your date of birth, health factors and death date.
# It is deliberately NOT tracked by git so it never reaches GitHub.
# See settings.example.json for the shape of the file.
settings.json

# ── Virtual environment ───────────────────────────────────────────────────────
# Recreated on any machine with `uv sync` -- never commit it.
.venv/
venv/

# ── Python bytecode and tool caches ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# ── Config write artifacts ────────────────────────────────────────────────────
# Left behind only if a settings save is interrupted partway through.
settings.json.tmp
settings.json.corrupt

# ── OS / editor cruft ─────────────────────────────────────────────────────────
# desktop.ini and Thumbs.db show up a lot inside OneDrive folders.
desktop.ini
Thumbs.db
.DS_Store
.vscode/
.idea/

# Recovery copies and unique atomic-write temporary files
settings.json.bak
settings.json.corrupt.*
settings.json.*.tmp
